{
	"extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
	"include": [
		"src/env.d.ts",
		"src/renderer/src/**/*",
		"src/preload/*.d.ts",
		"src/shared/**/*.ts",
		"src/translations/**/*.ts",
		"src/renderer/src/typings.d.ts",
		"src/main/contracts/**/*.d.ts"
	],
	"exclude": ["src/main/worker/**/*.ts"],
	"compilerOptions": {
		"composite": true,
		"baseUrl": ".",
		"jsx": "react-jsx",
		"allowSyntheticDefaultImports": true,
		"strict": true,
		"noImplicitReturns": false,
		"allowUnusedLabels": true,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"strictNullChecks": true,
		"isolatedModules": false,
		"skipLibCheck": true,
		"paths": {
			"@shared/*": ["src/shared/*"],
			"@translations/*": ["src/translations/*"],
			"@main/*": ["src/main/*"],
			"@routers/*": ["src/main/trpc/routers/*"],
			"@preload/*": ["src/preload/*"],
			"@renderer/*": ["src/renderer/src/*"],
			"@plugins/*": ["src/renderer-plugins/*"],
			"@/*": ["src/renderer/src/*"],
			"~/*": ["*"]
		},
		"types": []
	}
}
