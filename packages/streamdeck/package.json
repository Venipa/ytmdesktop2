{
	"name": "ytmdesktop2-streamdeck",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"icons": "node scripts/generate-icons.mjs",
		"build": "pnpm icons && vite build",
		"watch": "vite build --watch",
		"pack": "pnpm build && streamdeck pack com.venipa.ytmdesktop2.sdPlugin -f -o ../../dist/streamdeck"
	},
	"dependencies": {
		"@better-fetch/fetch": "^1.3.1",
		"@elgato/streamdeck": "^2.1.0"
	},
	"devDependencies": {
		"@elgato/cli": "^1.7.4",
		"@types/node": "^24.12.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"lucide-react": "^1.28.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"sharp": "^0.35.3",
		"typescript": "^5.9.3",
		"vite": "^8.2.0"
	}
}
