{
	"name": "ytmdesktop2-streamdeck",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "rollup -c",
		"watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.venipa.ytmdesktop2\"",
		"pack": "pnpm build && streamdeck pack com.venipa.ytmdesktop2.sdPlugin -f -o dist"
	},
	"dependencies": {
		"@elgato/streamdeck": "^2.1.0"
	},
	"devDependencies": {
		"@elgato/cli": "^1.7.4",
		"@rollup/plugin-commonjs": "^28.0.2",
		"@rollup/plugin-node-resolve": "^16.0.0",
		"@rollup/plugin-terser": "^0.4.4",
		"@rollup/plugin-typescript": "^12.1.2",
		"@types/node": "^24.12.0",
		"rollup": "^4.32.1",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3"
	}
}
